# Copy to .env to override defaults. docker compose loads this file automatically.

# Where the API stores its SQLite database (inside the api container).
DATABASE_URL=sqlite:////data/fair.db

# Origin the API accepts CORS requests from. In the Docker Compose setup,
# the browser only ever talks to nginx, so this only matters if you run
# the API directly against a different frontend origin.
CORS_ORIGIN=http://localhost:8080
