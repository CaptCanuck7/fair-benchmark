# Optional overrides. Copy to .env to use them; docker compose reads .env
# automatically. The only secret is ANTHROPIC_API_KEY, needed only for the
# agent. .env is gitignored: never commit it.

# Where the API stores its database, as a SQLAlchemy URL. The default keeps
# SQLite on the fair_data volume, mounted at /data in the api container.
# A Postgres URL would also work once a driver is added (see README, Decisions).
DATABASE_URL=sqlite:////data/fair.db

# The only browser origin the API accepts cross-origin requests from. In the
# compose setup the browser talks only to nginx on the same origin, so this
# matters only if you point a different frontend at the API.
CORS_ORIGIN=http://localhost:8080

# Largest request body the API accepts, in bytes (1 MB). nginx enforces the
# same 1 MB limit in web/nginx.conf; change both together.
MAX_BODY_BYTES=1048576

# Largest register workbook (.xlsx) the API accepts on /api/register/import,
# in bytes (5 MB). nginx enforces the same limit for that path in
# web/nginx.conf; change both together.
MAX_UPLOAD_BYTES=5242880

# --- Agent (AGENT_BUILD.md section 3) ---
# Without ANTHROPIC_API_KEY the rest of the app works normally and the agent
# is turned off, with a message explaining why.

# Claude API key. Passed to the agent container only; never logged.
ANTHROPIC_API_KEY=

# Model ID for agent tasks. Use a current Sonnet-class model.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Baseline score (impact x likelihood) at or above which a ready register risk
# qualifies for quantification. A baseline impact of 5 also qualifies.
TRIAGE_MIN_SCORE=6

# How many risks the api checks at once in the background (quality, triage,
# condition type). Raise it to finish large registers sooner, at the cost of
# more simultaneous Claude API calls.
AGENT_WORKERS=3

# false restricts the agent to internal evidence and the reference library:
# no public feeds, no web search.
AGENT_EXTERNAL_ENABLED=true

# Domains the agent may reach (subdomains included), comma-separated. The
# NVD, CISA KEV, EPSS and MITRE ATT&CK feed addresses are always allowed while
# external sources are on.
ALLOWED_DOMAINS=nvd.nist.gov,cisa.gov,first.org,attack.mitre.org,cisecurity.org,verizon.com,ibm.com,cyentia.com

# Optional NVD API key; raises NVD rate limits.
NVD_API_KEY=

# Your name, recorded as the reviewer when you approve agent drafts (the app
# has no sign-in).
ANALYST_NAME=
